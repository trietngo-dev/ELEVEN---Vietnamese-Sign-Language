    {
      "endpoint": "/api/gesture/predict-batch",
      "method": "POST",
      "description": "Batch prediction from 80 pre-flattened frames (258 features each)",
      "request_body": {
        "frames": [
          "[258 float values for frame 1]",
          "[258 float values for frame 2]",
          "...",
          "[258 float values for frame 80]"
        ]
      },
      "note": "Each frame is 258 pre-flattened features. If less than 80 frames provided, will be zero-padded automatically",
      "expected_response": {
        "predictedId": 3,
        "label": "chao",
        "confidence": 0.87,
        "probabilities": {
          "0": 0.05,
          "1": 0.08,
          "2": 0.0,
          "3": 0.87,
          "4": 0.0
        },
        "frameCount": 80,
        "timestamp": "2026-03-17T10:30:00Z"
      }
    },
    {
      "endpoint": "/api/gesture/add-frame",
      "method": "POST",
      "description": "Stream single frame for real-time prediction. Accumulate 80 frames then auto-predict",
      "request_body": {
        "pose": [
          {"x": 0.5, "y": 0.5, "z": 0.0, "visibility": 1.0},
          "... 32 more pose keypoints ..."
        ],
        "leftHand": [
          "... 21 left hand keypoints ..."
        ],
        "rightHand": [
          "... 21 right hand keypoints ..."
        ]
      },
      "note": "Call this 80 times. Responses 1-79: HTTP 202 (buffering). Response 80: HTTP 200 (prediction ready)",
      "expected_response_before_buffer_full": {
        "status": "Buffering",
        "currentFrames": 45,
        "maxFrames": 80,
        "progress": "56%"
      },
      "expected_response_after_buffer_full": {
        "status": "Prediction Ready",
        "predictedId": 3,
        "label": "chao",
        "confidence": 0.87,
        "probabilities": {...},
        "frameCount": 80
      }
    }
  ],
  "http_status_codes": {
    "200": "Success - Prediction result or data ready",
    "202": "Accepted - Frame buffered, waiting for more (real-time endpoint only)",
    "400": "Bad Request - Invalid input data",
    "500": "Server Error - Internal error during processing",
    "503": "Service Unavailable - Model files not found"
  },
  "quick_curl_examples": [
    {
      "name": "Health Check",
      "command": "curl http://localhost:5000/api/gesture/health"
    },
    {
      "name": "Model Info",
      "command": "curl http://localhost:5000/api/gesture/model-info"
    },
    {
      "name": "Predict Single",
      "command": "curl -X POST http://localhost:5000/api/gesture/predict -H \"Content-Type: application/json\" -d '{\"features\": [0.1, 0.2, ... 20640 values ...]}'"
    },
    {
      "name": "Extract Features",
      "command": "curl -X POST http://localhost:5000/api/gesture/extract-features -H \"Content-Type: application/json\" -d @keypoints.json"
    }
  ]
}
